<Window x:Class="WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="1000">
    <Grid Background="#080708">
        <Grid Margin="0 0 10 0"
              HorizontalAlignment="Left">
            <Border Background="#000000"
                    BorderBrush="#1F1E20"
                    BorderThickness="0 2 2 2"
                    CornerRadius="0 10 10 0"
                    Width="230">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MinWidth="200"
                            MinHeight="300">
                    <TextBlock Name="FromPath"
                               FontSize="25"
                               FontFamily="Segoe UI"
                               Foreground="#E4E4E6"
                               FontWeight="SemiBold"
                               Margin="20 10 0 0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Bottom">From:</TextBlock>
                    <Border Name="FromBtn"
                            Margin="10"
                            MinHeight="200" MaxHeight="200"
                            MinWidth="200" MaxWidth="200"
                            Background="#0C0C0E"
                            BorderBrush="#1F1E20"
                            BorderThickness="2"
                            CornerRadius="10"
                            Cursor="Hand"
                            MouseLeftButtonDown="chooseFromFile">
                        <TextBlock FontSize="25"
                                   FontFamily="Segoe UI"
                                   Foreground="#E4E4E6"
                                   FontWeight="SemiBold"
                                   Margin="20px"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">From</TextBlock>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
        
        <Grid Margin="10 0 0 0"
              HorizontalAlignment="Right">
            <Border Background="#000000"
                    BorderBrush="#1F1E20"
                    BorderThickness="2 2 0 2"
                    CornerRadius="10 0 0 10"
                    Width="230">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MinWidth="200"
                            MinHeight="300">
                    <TextBlock Name="ToPath"
                               FontSize="25"
                               FontFamily="Segoe UI"
                               Foreground="#E4E4E6"
                               FontWeight="SemiBold"
                               Margin="20 10 0 0"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Bottom">To:</TextBlock>
                    <Border Name="ToBtn"
                            Margin="10"
                            MinHeight="200" MaxHeight="200"
                            MinWidth="200" MaxWidth="200"
                            Background="#0C0C0E"
                            BorderBrush="#1F1E20"
                            BorderThickness="2"
                            CornerRadius="10"
                            Cursor="Hand"
                            MouseLeftButtonDown="chooseToFolder">
                        <TextBlock FontSize="25"
                                   FontFamily="Segoe UI"
                                   Foreground="#E4E4E6"
                                   FontWeight="SemiBold"
                                   Margin="20px"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center">To</TextBlock>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
        
        <Grid Margin="10"
              VerticalAlignment="Center">
            <Border Name="CopyBtn"
                    HorizontalAlignment="Center"
                    Background="#0C0C0E"
                    MinHeight="500" MaxHeight="1200"
                    MinWidth="500" MaxWidth="800"
                    CornerRadius="10"
                    BorderBrush="#1F1E20"
                    BorderThickness="2"
                    Padding="2"
                    Cursor="Hand"
                    MouseLeftButtonDown="copyButton_Click">
                <TextBlock FontSize="100"
                           FontFamily="Segoe UI"
                           Foreground="#E4E4E6"
                           FontWeight="SemiBold"
                           Margin="20px"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">Copy</TextBlock>
            </Border>
        </Grid>
    </Grid>
</Window>